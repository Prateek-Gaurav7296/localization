# Root directory for per-upload run folders (relative paths resolve against the project root).
INPUT_ROOT=./input
# FFmpeg / FFprobe executables (name on PATH or absolute path).
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Reject uploads larger than this many megabytes (HTTP 413).
MAX_UPLOAD_SIZE_MB=2048
# Kill any single ffmpeg invocation that runs longer than this.
FFMPEG_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO
# Used by run.py only.
HOST=0.0.0.0
PORT=8000
