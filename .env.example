# ---- Paths --------------------------------------------------------------------------------
# All generated data lives here (relative paths resolve against the repository root).
DATA_DIR=./data
# One folder per localization run: <RUNS_DIR>/<video name>/<timestamp>/
RUNS_DIR=./data/runs

# ---- Pipeline selection -------------------------------------------------------------------
# STT -> TTT -> TTS engine: "ishnit" (real implementation, being integrated) or "mock" (dev only).
LOCALIZATION_ENGINE=mock
# Lip-sync provider: "sync" (Sync.so) or "mock" (dev only: swaps the audio track, no lip-sync).
LIPSYNC_PROVIDER=sync

# ---- Input stage (FFmpeg) -----------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MAX_UPLOAD_SIZE_MB=2048
FFMPEG_TIMEOUT_SECONDS=3600

# ---- Output stage (Sync.so API) -----------------------------------------------------------
SYNC_API_KEY=
SYNC_MODEL=sync-3
SYNC_TIMEOUT_SECONDS=600
SYNC_POLL_INTERVAL_SECONDS=5
# Where the standalone POST /sync API saves results (the pipeline uses each run's folder).
SYNC_OUTPUT_DIR=./data/sync_output

LOG_LEVEL=INFO
